# Runtime mode: mock | replay | live | record
LLM_MODE=mock

HOST=127.0.0.1
PORT=8000
TARGET_PORT=8001
# Where the control plane reaches the target. Empty = HOST.
# In docker compose this is the service name: target-api
TARGET_HOST=
# Start the USB/network watchers with the control plane.
ENABLE_WATCHERS=1

# ---------------------------------------------------------------------------
# Meta Model API  (https://dev.meta.ai/docs)
# The docs and the SDK use MODEL_API_KEY; META_API_KEY is accepted as fallback.
# Hosted models: muse-spark-1.3 (1M context), sam-3.1.
# ---------------------------------------------------------------------------
MODEL_API_KEY=
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# ---------------------------------------------------------------------------
# Baseten - hackathon participant guide override:
#   "The docs use meta-models/muse-spark-open. For the hackathon, use
#    meta-models/muse-spark-open-1026 instead."
# ---------------------------------------------------------------------------
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1

# ---------------------------------------------------------------------------
# Fireworks - can also serve the open-weight Muse Glimmer / Spark Open.
# ---------------------------------------------------------------------------
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ---------------------------------------------------------------------------
# Modal - Serverless GPU & Model Endpoints (Hackathon approved)
# ---------------------------------------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_PROFILE=
MODAL_PROXY_TOKEN=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Modal (serverless GPU/CPU Segment Anything, scripts/modal_sam.py)
# Deploy:  modal deploy scripts/modal_sam.py
# Secret:  modal secret create meta-guardian-sam MG_SAM_TOKEN=<random>
# GPU needs a payment method on the Modal account even with credits; set
# MG_SAM_GPU=cpu to validate on CPU (ViT-B on 640x480 is ~2-25 s).
# ---------------------------------------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_SAM_URL=
MODAL_SAM_TOKEN=
MODAL_SAM_TIMEOUT=180
# Modal Proxy Auth pair (only if the endpoint uses requires_proxy_auth)
MODAL_PROXY_TOKEN=
MODAL_PROXY_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Model routing
# OODA_MODEL: open-weight Muse Glimmer, self-hosted (vLLM/SGLang/llama.cpp)
#             or served through Fireworks/Baseten. The exact served id depends
#             on your endpoint; run scripts/smoke_test_providers.py to list it.
# FORENSICS_MODEL / CODE_MODEL: hosted Muse Spark 1.3 (1M context).
#             NOTE: "Muse Code" is a terminal/CI agent, not an API model.
# SAM_MODEL: hosted Segment Anything 3.1 on Meta Model API.
# SPARK_OPEN_MODEL: Baseten hosted open-weight Spark Open for the bonus track.
# ---------------------------------------------------------------------------
OODA_MODEL=muse-glimmer
FORENSICS_MODEL=muse-spark-1.3
CODE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# Vision
WEBCAM_INDEX=0
# Calibrate with `python scripts/calibrate_baseline.py` while the seat is empty.
# BASELINE_FRAME=data/runtime/baseline.png
OPERATOR_MOTION_THRESHOLD=0.004

# Inference
REQUEST_TIMEOUT=60
TEMPERATURE=0.2
MAX_TOKENS=2048
# Reasoning models spend the token budget in reasoning_content; keep this low.
REASONING_EFFORT=low

# Gateway hardening
# Trust X-Forwarded-For only behind a proxy you control.
TRUST_FORWARDED_FOR=0
# Shared secret for /internal/* on the target service.
# docker-compose.yml defaults to the same value, so host scripts and containers agree.
INTERNAL_API_TOKEN=dev-token

# Containment / policy
ACTION_TIMEOUT=10
MAX_ACTIONS_PER_MINUTE=30
CORRELATION_WINDOW_SECONDS=30
CORRELATION_COOLDOWN_SECONDS=10
# comma-separated process names allowed for kill_process (empty = allow all but system)
KILL_ALLOWLIST=
PERSIST_INCIDENTS=1
# QUARANTINE_DIR=quarantine
# CHANGE_TICKETS_PATH=data/change_tickets.json

# Optional path overrides
# FIXTURES_DIR=data/fixtures
# RUNTIME_DIR=data/runtime
