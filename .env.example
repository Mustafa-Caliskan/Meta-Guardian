# Runtime mode: mock | replay | live | record
LLM_MODE=mock

HOST=127.0.0.1
PORT=8000
TARGET_PORT=8001

# ---------------------------------------------------------------------------
# Meta Model API  (https://dev.meta.ai/docs)
# The docs and the SDK use MODEL_API_KEY; META_API_KEY is accepted as fallback.
# Hosted models: muse-spark-1.3 (1M context), sam-3.1.
# ---------------------------------------------------------------------------
MODEL_API_KEY=
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# ---------------------------------------------------------------------------
# Baseten - hackathon participant guide override:
#   "The docs use meta-models/muse-spark-open. For the hackathon, use
#    meta-models/muse-spark-open-1026 instead."
# ---------------------------------------------------------------------------
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1

# ---------------------------------------------------------------------------
# Fireworks - can also serve the open-weight Muse Glimmer / Spark Open.
# ---------------------------------------------------------------------------
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# ---------------------------------------------------------------------------
# Model routing
# OODA_MODEL: open-weight Muse Glimmer, self-hosted (vLLM/SGLang/llama.cpp)
#             or served through Fireworks/Baseten. The exact served id depends
#             on your endpoint; run scripts/smoke_test_providers.py to list it.
# FORENSICS_MODEL / CODE_MODEL: hosted Muse Spark 1.3 (1M context).
#             NOTE: "Muse Code" is a terminal/CI agent, not an API model.
# SAM_MODEL: hosted Segment Anything 3.1 on Meta Model API.
# SPARK_OPEN_MODEL: Baseten hosted open-weight Spark Open for the bonus track.
# ---------------------------------------------------------------------------
OODA_MODEL=muse-glimmer
FORENSICS_MODEL=muse-spark-1.3
CODE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# Vision
WEBCAM_INDEX=0

# Inference
REQUEST_TIMEOUT=60
TEMPERATURE=0.2
MAX_TOKENS=2048

# Optional path overrides
# FIXTURES_DIR=data/fixtures
# RUNTIME_DIR=data/runtime
